{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd .. && npm ci --include=dev",
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://srv1388438.hstgr.cloud/cleides/api/:path*" },
    { "source": "/sitemap.xml", "destination": "https://srv1388438.hstgr.cloud/cleides/api/v1/sitemap.xml" },
    {
      "source": "/images/og-card.jpg",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*whatsapp.*" }],
      "destination": "/images/og-whatsapp.jpg"
    },
    { "source": "/images/og-card.jpg", "destination": "/images/og-capa.jpg" },
    { "source": "/((?!assets/|images/|robots.txt|sitemap.xml|favicon|apple-touch-icon).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com; connect-src 'self' https:; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/images/og-card.jpg",
      "headers": [
        { "key": "Vary", "value": "User-Agent" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
