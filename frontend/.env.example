# ---------------------------------------------------------------
# Frontend — copie para .env e preencha. Somente valores PÚBLICOS:
# tudo que começa com VITE_ é incluído no código enviado ao navegador.
# ---------------------------------------------------------------

# Endereço da API (inclui /api/v1)
VITE_API_URL=http://localhost:4000/api/v1

# Endereço público do site (URLs canônicas e compartilhamento)
VITE_SITE_URL=http://localhost:5173

# Supabase: Project Settings → API (usado apenas para o login do painel)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
