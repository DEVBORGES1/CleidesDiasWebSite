# ---------------------------------------------------------------
# Backend — copie para .env e preencha. NUNCA versione o .env real.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Origens autorizadas no CORS (separadas por vírgula).
FRONTEND_URL=http://localhost:5173
# Endereço público do site (usado no sitemap).
SITE_URL=http://localhost:5173
# Quantidade de proxies à frente da API (Render = 1).
TRUST_PROXY=0

# supabase (padrão) | memory (somente desenvolvimento/testes, dados não persistem)
DATA_DRIVER=supabase
MEMORY_SEED=false

# Supabase: Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave privilegiada — exclusiva do backend.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary: Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Segredo — exclusivo do backend.
CLOUDINARY_API_SECRET=
