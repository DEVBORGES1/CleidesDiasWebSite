{
  "name": "@cleides/backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST da Cleides Dias Fotografia",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --conditions=development --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx --conditions=development scripts/seed.ts",
    "create-admin": "tsx --conditions=development scripts/create-admin.ts",
    "media:cleanup": "tsx --conditions=development src/jobs/media-cleanup.ts"
  },
  "dependencies": {
    "@cleides/shared": "1.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
